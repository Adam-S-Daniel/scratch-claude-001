{
  "extraKnownMarketplaces": {
    "agentskills": {
      "source": {
        "source": "github",
        "repo": "Adam-S-Daniel/agentskills"
      }
    }
  },
  "enabledPlugins": {
    "adam@agentskills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ claude plugin marketplace add Adam-S-Daniel/agentskills; claude plugin install adam@agentskills; } > /tmp/e1-hook.log 2>&1; echo \"e1-hook: ran (exit $?); log at /tmp/e1-hook.log\""
          }
        ]
      },
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/fleet-memory.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-checks-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guidance-load-record.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "disableSkillShellExecution": true
}
